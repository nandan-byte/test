{
  "AppSecAI": {
    "product": "HireSense",
    "version": "v1.0.0",
    "environment": {
      "deployment_type": "public",
      "internet_exposure": true,
      "api_type": "rest",
      "https_enabled": false,
      "data_classification": "confidential",
      "pii_present": true,
      "logging_audit_required": false,
      "encryption_in_transit_required": false,
      "encryption_at_rest_required": false,
      "system_criticality": "high"
    },
    "runtime": {
      "containerized": false,
      "root_container": true,
      "container_sig_enforced": false,
      "runtime_monitoring_enabled": false,
      "language_runtime": {
        "python_version": "3.10",
        "node_version": "18",
        "go": "1.24.2",
        "python": "3.10"
      },
      "service_authn": false,
      "rate_limiting_enabled": false,
      "memory_limits_enforced": true,
      "cpu_limits_enforced": false
    },
    "security_controls": {
      "rbac_enabled": false,
      "waf_enabled": false,
      "ids_enabled": false,
      "nfw_enabled": false,
      "sso_enabled": false,
      "mfa_required_for_admin": false,
      "infrastructure_as_code_scan_enabled": false,
      "dependency_vulnerability_scan_enabled": false,
      "container_image_scan_enabled": false,
      "api_input_validation": false,
      "api_authentication_required": false,
      "secrets_vault_enabled": false,
      "rate_limiting_enabled": false,
      "cloud_security_posture_management": false,
      "business_logic_testing": false,
      "data_loss_prevention": false,
      "network_segmentation": false,
      "privileged_access_management": false,
      "api_security_gateway": false,
      "third_party_risk_assessment": true,
      "input_validation": false,
      "key_management_system": false
    },
    "sca_context": {
      "dependency_management": {
        "dependency_update_frequency": "monthly",
        "lock_files_enforced": false,
        "automated_dependency_updates": false,
        "dependency_review_process": "none",
        "dependency_pinning_strategy": "minor",
        "dependency_approval_required": true,
        "sbom_generation_enabled": false,
        "license_compliance_checking": true,
        "dependency_pinning": false,
        "transitive_dependency_analysis": false,
        "sbom_format": "none"
      },
      "package_sources": {
        "private_registry_used": true,
        "registry_mirrors_used": false,
        "package_signature_verification": true,
        "trusted_sources_only": true,
        "allow_public_registries": false,
        "registry_scanning_enabled": true,
        "package_provenance_tracking": true
      },
      "dependency_usage": {
        "unused_dependencies_present": false,
        "dev_dependencies_in_production": false,
        "optional_dependencies_used": true,
        "peer_dependencies_managed": true
      },
      "vulnerability_response": {
        "mean_time_to_patch": "> 30d",
        "vulnerability_monitoring": "daily",
        "emergency_patch_process": true,
        "vulnerability_disclosure_policy": true,
        "security_champion_assigned": true,
        "vulnerability_sla_defined": true
      },
      "build_pipeline": {
        "dependency_caching_used": true,
        "build_reproducibility": true,
        "dependency_hash_verification": true,
        "isolated_build_environment": true,
        "build_artifact_signing": true,
        "supply_chain_levels_for_software_artifacts": "slsa3"
      },
      "runtime_behavior": {
        "dependency_isolation": true,
        "sandboxing_enabled": false,
        "runtime_dependency_monitoring": true,
        "dynamic_loading_restricted": true,
        "native_code_dependencies": true,
        "network_access_by_dependencies": "restricted"
      },
      "ecosystem": {
        "primary_language": "javascript",
        "package_manager": "npm",
        "language_version_eol": false,
        "package_manager_version": "latest",
        "ecosystem_security_tools": [
          "snyk",
          "dependabot",
          "renovate"
        ],
        "monorepo": false
      },
      "compliance": {
        "soc2_compliance_required": true,
        "hipaa_compliance_required": false,
        "pci_dss_compliance_required": false,
        "gdpr_compliance_required": false,
        "iso_27001_compliance_required": true
      }
    },
